{
  "name": "illke",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/discord-bot",
    "services/battle-engine"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @illke/web",
    "dev:engine": "npm run dev -w @illke/battle-engine",
    "dev:bot": "npm run start -w @illke/discord-bot",
    "sync:data": "node scripts/sync-data.mjs",
    "audit:assets": "node scripts/audit-assets.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run check -w @illke/web",
    "build": "npm run build -w @illke/web",
    "dev": "node scripts/dev.mjs",
    "stop": "node scripts/dev.mjs --stop",
    "doctor": "node scripts/doctor.mjs",
    "test:browser": "playwright test",
    "setup": "node scripts/setup.mjs",
    "sync:icons": "node scripts/sync-icons.mjs"
  },
  "dependencies": {
    "@smogon/calc": "^0.10.0",
    "csv-parse": "^7.0.3",
    "pokemon-showdown": "^0.11.10",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0"
  },
  "engines": {
    "node": ">=24.17.0"
  }
}
